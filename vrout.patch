+func bindSourcePort[T any](d *Direct, open func(int) (T, error)) (T, error) {
+	if d.sourcePortFirst == 0 {
+		return open(0)
+	}
+	size := int(d.sourcePortLast) - int(d.sourcePortFirst) + 1
+	start := rand.Intn(size)
+	var result T
+	var err error
+	for i := 0; i < size && i < 32; i++ {
+		port := int(d.sourcePortFirst) + (start+i)%size
+		result, err = open(port)
+		if err == nil || !(errors.Is(err, syscall.EADDRINUSE) ||
+			errors.Is(err, syscall.Errno(10048)) || errors.Is(err, syscall.Errno(10013))) {
+			break
+		}
+	}
+	return result, err
 }
 
